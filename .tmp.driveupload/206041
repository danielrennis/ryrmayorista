    <div class="row">
      <div class="tile search-tile">
        <input id="txtSearch" placeholder="Buscar por nombre, código o marca..."/>
      </div>
      <div class="tile filters-tile">
        <label class="filter-item"><input id="chkAll" type="checkbox"/> Coincidir todas</label>
        <label class="filter-item"><input checked id="chkStock" type="checkbox"/> Solo Stock</label>
      </div>
    </div>
  </div>
</header>

<nav class="bottom-nav">
  <div class="tile" style="flex:1; justify-content: center; background: var(--accent-light); border: 1px solid var(--accent); color: var(--accent);">
    <div id="mobTotal" style="font-weight: 900; font-size: 16px;">$ 0</div>
  </div>
  <button class="btn-add" id="btnCartMob" style="flex:1.5; font-size: 14px; display: flex; align-items: center; justify-content: center; gap: 8px;">
    🛒 VER PEDIDO (<span id="cartCountMob">0</span>)
  </button>
</nav>

<main class="container">
  <div class="promo-banner">
    <img src="promo_tuya.png?v=1.1.94" alt="Promo Tuya - 3 cuotas sin interés"/>
  </div>
  <div class="grid" id="grid">
    <div style="grid-column:1/-1; text-align:center; padding:100px; color:var(--muted); font-weight:700;">Cargando catálogo...</div>
  </div>
</main>

<div class="drawer" id="drawer">
  <div class="mask"></div>
  <aside class="panel">
    <div class="panel-head">
      <h2 style="margin:0; font-size:22px; font-weight:900;">Mi Carrito</h2>
      <button id="btnClose" style="background:none; border:none; font-size:32px; cursor:pointer; color:var(--muted);">&times;</button>
    </div>
    <div class="panel-body">
      <div id="cartItems"></div>
      <div style="margin-top:40px; padding-top:20px; border-top:2px solid var(--line);">
        <h3 style="font-size:18px; font-weight:900; margin-bottom:20px;">Datos del Cliente</h3>
        <input class="input-field" id="cliName" placeholder="Nombre y Apellido *"/>
        <input class="input-field" id="cliDni" placeholder="DNI / CUIT *"/>
        <input class="input-field" id="cliPhone" placeholder="Celular (con código de área) *"/>
        <input class="input-field" id="cliAddr" placeholder="Dirección de Entrega *"/>
        <input class="input-field" id="cliCityProv" placeholder="Localidad y Provincia *"/>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
          <select class="input-field" id="cliPay">
            <option>Efectivo</option>
            <option>Transferencia</option>
            <option>Contrareembolso</option>
          </select>
          <select class="input-field" id="cliShip">
            <option value="Transpaq">Transpaq ($6000)</option>
            <option value="Testa">Testa ($7000)</option>
            <option value="Niclis">Niclis ($6000)</option>
            <option value="Local">Retiro en Local ($0)</option>
          </select>
        </div>
        <input class="input-field" id="cliNotes" placeholder="Observaciones adicionales"/>
        <div class="hidden" id="formErr" style="background:#fef2f2; color:#be123c; padding:12px; border-radius:12px; font-size:13px; font-weight:700; margin-top:10px; border:1px solid #fecaca;"></div>
      </div>
    </div>
    <div class="panel-foot">
      <div class="total-row"><span>Subtotal:</span> <span id="lblSub">$ 0</span></div>
      <div class="total-row"><span>Costo de Envío:</span> <span id="lblShip">-</span></div>
      <div class="total-row grand"><span>TOTAL:</span> <span id="lblTotal">$ 0</span></div>
      <div style="margin-top:20px;">
        <span style="font-size:12px; font-weight:800; color:var(--muted); display:block; margin-bottom:8px;">ELEGIR VENDEDOR:</span>
        <select class="input-field" id="selSalesCart" style="background:white;"></select>
      </div>
      <button class="btn-send" id="btnWA">
        <svg viewbox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        CONFIRMAR PEDIDO
      </button>
    </div>
  </aside>
</div>

<!-- HIDDEN FOR COMPATIBILITY -->
<select id="selCat" class="hidden"></select>
<select id="selSort" class="hidden"><option value="lastBuy">Última compra</option></select>

<script>
(function(){
  var VERSION = "1.1.94";
  var ARS = new Intl.NumberFormat("es-AR", {style:"currency", currency:"ARS", minimumFractionDigits:0});
  var TIER_KEYS = ["Mayorista", "Especial Mayorista", "Súper Especial", "Distribuidor"];
  var PRICE_ALIAS = {
    "Mayorista": ["Mayorista"],
    "Especial Mayorista": ["Especial Mayorista", "Especial"],
    "Súper Especial": ["Súper Especial", "Super Especial"],
    "Distribuidor": ["Distribuidor", "Dist"]
  };
  var SALES = [
    {name:"Emanuel", phone:"5493624996333"},
    {name:"Daniela", phone:"5493624251555"},
    {name:"Sucursal Corrientes", phone:"5493624720453"},
    {name:"Sucursal Formosa", phone:"5493624901455"}
  ];

  var products = [], filtered = [], page = 1, PAGE_SIZE = 40;
  var cart = (function(){ try{return JSON.parse(localStorage.getItem("ryr.cart.v2")||"{}")}catch(_){return{}} })();
  var client = (function(){ try{return JSON.parse(localStorage.getItem("ryr.client.v2")||'{"salesIdx":0,"pay":"Efectivo","ship":"Transpaq","shipCost":6000}')}catch(_){return {salesIdx:0,pay:"Efectivo",ship:"Transpaq",shipCost:6000}} })();
  var query = "", category = "Todas", tier = "Especial Mayorista", onlyStock = true;

  function $(id){ return document.getElementById(id); }
  function norm(s){ return String(s||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().trim(); }
  function asNum(v){ return isNaN(parseFloat(v)) ? 0 : parseFloat(v); }
  function save(){ localStorage.setItem("ryr.cart.v2", JSON.stringify(cart)); localStorage.setItem("ryr.client.v2", JSON.stringify(client)); }

  function getPrice(p, t){
    if(!p || !p.prices) return 0;
    var aliases = PRICE_ALIAS[t] || [t];
    var val = 0;
    aliases.forEach(function(a){
      var n = norm(a);
      for(var k in p.prices) if(norm(k) === n) val = asNum(p.prices[k]);
    });
    if(val > 0) return val;
    for(var k in p.prices) if(norm(k)==="mayorista") return asNum(p.prices[k]);
    return 0;
  }

  function getStock(p){
    var s = asNum(p.stock); if(s > 0) return s;
    if(p.stocks){ var sum=0; for(var k in p.stocks) sum += asNum(p.stocks[k]); return sum; }
    return 0;
  }

  function render(){
    var qn = norm(query);
    filtered = products.filter(function(p){
      p._stk = getStock(p);
      if(onlyStock && p._stk <= 0) return false;
      if(category !== "Todas" && p.category !== category) return false;

      // Regla: Si se elige lista Mayorista, ocultar productos que SOLO tienen lista Distribuidor
      if(tier === "Mayorista" && p.prices){
        var dPrice = asNum(p.prices['Distribuidor']);
        var l1 = asNum(p.prices['Mayorista']), l2 = asNum(p.prices['Especial Mayorista']), l3 = asNum(p.prices['Super Especial']);
        if(dPrice > 0 && l1 <= 0 && l2 <= 0 && l3 <= 0) return false;
      }

      if(!qn) return true;
      var text = norm((p.name||"") + " " + (p.sku||"") + " " + (p.brand||""));
      return qn.split(/\s+/).every(function(w){ return text.indexOf(w) >= 0; });
    });

    filtered.sort(function(a,b){
      var da = a.lastBuy ? Date.parse(a.lastBuy) : 0;
      var db = b.lastBuy ? Date.parse(b.lastBuy) : 0;
      return db - da || (a.name||"").localeCompare(b.name||"");
    });

    var upto = page * PAGE_SIZE;
    var show = filtered.slice(0, upto);
    $("grid").innerHTML = show.map(function(p){
      var unit = getPrice(p, tier);
      var qty = cart[p.id] || 0;
      var img = (p.imageUrls && p.imageUrls[0]) || "logo.png";
      
      var isDist = false, onlyDist = false;
      if(p.prices){
        var dPrice = asNum(p.prices['Distribuidor']);
        var l1 = asNum(p.prices['Mayorista']), l2 = asNum(p.prices['Especial Mayorista']), l3 = asNum(p.prices['Super Especial']);
        if(dPrice > 0) isDist = true;
        if(isDist && l1<=0 && l2<=0 && l3<=0) onlyDist = true;
      }

      return `
        <div class="card ${isDist?'is-dist':''}">
          ${onlyDist ? '<div class="dist-label">SOLO DISTRIBUIDOR</div>' : ''}
          <div class="img"><img src="${img}" onerror="this.src='logo.png'"/></div>
          <div class="body">
            <div class="name">${p.name}</div>
            <div class="meta">
              <span class="badge">SKU: ${p.sku}</span>
              <span class="badge">Stock: ${p._stk}</span>
            </div>
            <div class="price">${ARS.format(unit)}</div>
            <div class="controls">
              <div class="qty-box">
                <button class="qty-btn" onclick="window.setQty('${p.id}',-1)">−</button>
                <span class="qty-val">${qty}</span>
                <button class="qty-btn" onclick="window.setQty('${p.id}',1)">+</button>
              </div>
              <button class="btn-add ${isDist?'btn-rojo':''}" onclick="window.setQty('${p.id}', 1)">AGREGAR</button>
            </div>
          </div>
        </div>
      `;
    }).join("") + (upto < filtered.length ? `<div style="grid-column:1/-1; text-align:center; padding:20px;"><button class="tile" style="margin:0 auto; cursor:pointer; font-weight:900;" onclick="window.more()">CARGAR MÁS (${filtered.length-upto} RESTANTES)</button></div>` : "");

    // Update Totals
    var sub = 0;
    Object.entries(cart).forEach(function(kv){
      var p = products.find(function(x){return x.id===kv[0]});
      if(p) sub += getPrice(p, tier) * kv[1];
    });
    $("cartCount").textContent = Object.values(cart).reduce(function(a,b){return a+b}, 0);
    if($("cartCountMob")) $("cartCountMob").textContent = $("cartCount").textContent;
    
    $("kpiTotal").textContent = ARS.format(sub);
    if($("mobTotal")) $("mobTotal").textContent = ARS.format(sub);

    $("lblSub").textContent = ARS.format(sub);
    var ship = client.shipCost || 0;
    $("lblShip").textContent = client.ship ? (client.ship + " ("+ARS.format(ship)+")") : "-";
    $("lblTotal").textContent = ARS.format(sub + ship);

    // Categories
    // var cats = {}; products.forEach(function(p){ if(p.category) cats[p.category]=1; });
    // if($("catBar")) $("catBar").innerHTML = ['Todas'].concat(Object.keys(cats).sort()).map(function(c){
    //   return `<div class="cat-pill ${c===category?'active':''}" onclick="window.setCat('${c}')">${c}</div>`;
    // }).join("");
  }

  window.setQty = function(id, d){
    var q = (cart[id]||0) + d;
    if(q <= 0) delete cart[id]; else cart[id] = q;
    save(); render(); renderCartItems();
  };
  window.more = function(){ page++; render(); };
  window.setCat = function(c){ category=c; page=1; render(); };
  window.setTier = function(t){ tier=t; render(); };

  function renderCartItems(){
    var html = "";
    Object.entries(cart).forEach(function(kv){
      var p = products.find(function(x){return x.id===kv[0]});
      if(!p) return;
      var unit = getPrice(p, tier);
      var img = (p.imageUrls && p.imageUrls[0]) || "logo.png";
      html += `
        <div class="cart-item">
          <img src="${img}"/>
          <div class="info">
            <div class="name">${p.name}</div>
            <div class="price">${kv[1]} x ${ARS.format(unit)}</div>
          </div>
          <button onclick="window.setQty('${p.id}',-999)" style="border:none; background:none; cursor:pointer; font-size:18px;">🗑️</button>
        </div>
      `;
    });
    $("cartItems").innerHTML = html || '<div style="text-align:center; padding:40px; color:var(--muted); font-weight:700;">Tu carrito está vacío</div>';
  }

  function boot(){
    var openCart = function(){ $("drawer").classList.add("show"); renderCartItems(); };
    $("btnCart").onclick = openCart;
    if($("btnCartMob")) $("btnCartMob").onclick = openCart;
    
    $("btnClose").onclick = function(){ $("drawer").classList.remove("show"); };
    document.querySelector(".mask").onclick = function(){ $("drawer").classList.remove("show"); };

    $("selTier").onchange = function(){ tier=this.value; render(); };
    $("txtSearch").oninput = function(){ query=this.value; page=1; render(); };
    $("chkAll").onchange = function(){ render(); };
    $("chkStock").onchange = function(){ onlyStock=this.checked; page=1; render(); };

    ["cliName","cliDni","cliPhone","cliAddr","cliCityProv","cliPay","cliShip","cliNotes"].forEach(function(id){
      var k = id.replace("cli","").toLowerCase();
      if(id==="cliCityProv") k="cityProv";
      $(id).value = client[k] || "";
      $(id).oninput = function(){
        client[k] = this.value;
        if(id==="cliShip"){
          var costs = {"Transpaq":6000,"Testa":7000,"Niclis":6000,"Local":0};
          client.shipCost = costs[this.value] || 0;
        }
        save(); render();
      }
    });

    $("selSalesCart").innerHTML = SALES.map(function(s,i){ return `<option value="${i}" ${i==client.salesIdx?'selected':''}>${s.name}</option>` }).join("");
    $("selSalesCart").onchange = function(){ client.salesIdx=this.value; save(); };

    $("btnWA").onclick = function(){
      if(!$("cliName").value){ $("formErr").textContent="Faltan datos obligatorios"; $("formErr").classList.remove("hidden"); return; }
      var items = Object.entries(cart).map(function(kv){
        var p = products.find(function(x){return x.id===kv[0]});
        if(!p) return null;
        return {p:p, q:kv[1], u:getPrice(p, tier)};
      }).filter(Boolean);
      if(!items.length) return;
      var sub = items.reduce(function(a,b){return a + b.q*b.u}, 0);
      var ship = client.shipCost || 0;
      var text = `*PEDIDO WEB RyR*\n*Lista:* ${tier}\n*Cliente:* ${client.name}\n*DNI:* ${client.dni}\n*Envío:* ${client.ship} (${ARS.format(ship)})\n\n*DETALLE:*\n` + 
                 items.map(function(it){ return `• ${it.q} x ${it.p.name} (${it.p.sku||"-"})` }).join("\n") + 
                 `\n\n*TOTAL: ${ARS.format(sub+ship)}*\n\nIMPORTANTE: Confirmar stock antes de transferir.`;
      window.open("https://wa.me/"+SALES[client.salesIdx].phone+"?text="+encodeURIComponent(text), "_blank");
    };

    fetch("catalog.json?v="+Date.now()).then(function(r){return r.json()}).then(function(d){
      products = d.products || d;
      $("selTier").innerHTML = TIER_KEYS.map(function(k){return `<option ${k===tier?'selected':''}>${k}</option>`}).join("");
      render();
    }).catch(function(e){ $("grid").innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:40px; color:red;">Error al cargar catálogo. Reintente.</div>'; });
  }

  boot();
})();
</script>
</body>
</html>
