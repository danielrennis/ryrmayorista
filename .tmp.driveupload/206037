<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RyR Mayorista — Pedidos Online</title>
    <link rel="icon" href="/logo.png">
    <link rel="stylesheet" href="/src/style.css">
</head>
<body>
    <header class="toolbar">
        <div class="container">
            <div class="row">
                <div class="tile logo-tile">
                    <img src="/logo.png" alt="RyR Logo">
                    <div class="title-box">
                        <span class="title">RyR Mayorista</span>
                        <span class="version">v2.1 — Supabase Powered</span>
                    </div>
                </div>
                <span style="flex:1"></span>
                
                <!-- Auth Section -->
                <div id="auth-unlogged" class="row" style="gap: 8px;">
                    <button class="auth-btn" id="btn-open-login">INGRESAR</button>
                </div>
                <div id="auth-logged" class="tile hidden">
                    <i data-lucide="user" style="width: 18px; color: var(--accent);"></i>
                    <span id="user-email-display" style="font-weight: 700; font-size: 14px;"></span>
                    <button id="btn-logout" style="background:none; border:none; cursor:pointer; color: var(--muted);"><i data-lucide="log-out" style="width: 18px;"></i></button>
                </div>

                <div class="tile cart-tile" id="btn-cart">
                    <i data-lucide="shopping-cart" style="width: 20px;"></i>
                    <span style="margin-left: 8px;">MI PEDIDO (<span id="cart-count">0</span>)</span>
                </div>
            </div>

            <div class="row">
                <div class="tile search-tile">
                    <i data-lucide="search" style="width: 20px; color: var(--muted); margin-left: 16px;"></i>
                    <input type="text" id="txt-search" placeholder="Buscar productos por nombre o SKU...">
                </div>
                <div class="tile price-tile" id="topPriceTile">
                    <span style="font-size:12px; font-weight:700; color:var(--muted)">LISTA:</span>
                    <select id="sel-tier" style="border:none; padding:0; font-weight:900; outline:none; cursor:pointer; font-size:14px; color:var(--accent); background:transparent;">
                        <option>Mayorista</option>
                        <option>Especial Mayorista</option>
                        <option>Súper Especial</option>
                        <option>Distribuidor</option>
                    </select>
                </div>
                <button class="tile" id="btn-history" style="cursor:pointer; font-weight:700;"><i data-lucide="clock"></i></button>
            </div>
        </div>
    </header>

    <main class="container">
        <div id="main-grid" class="grid">
            <!-- Products will be injected here -->
            <div style="grid-column:1/-1; text-align:center; padding:100px; color:var(--muted); font-weight:700;">Cargando catálogo...</div>
        </div>
    </main>

    <!-- DRAWERS -->
    <!-- Cart Drawer -->
    <div class="drawer" id="cart-drawer">
        <div class="mask"></div>
        <aside class="panel">
            <div class="panel-head">
                <h2 style="margin:0; font-weight:900;">Mi Carrito</h2>
                <button class="btn-close" style="background:none; border:none; font-size:32px; cursor:pointer;">&times;</button>
            </div>
            <div class="panel-body" id="cart-items">
                <!-- Cart items go here -->
            </div>
            <div class="panel-foot">
                <div style="display:flex; justify-content:space-between; font-size:18px; font-weight:800; margin-bottom:20px;">
                    <span>TOTAL:</span>
                    <span id="cart-total" style="color:var(--accent); font-size:24px;">$ 0</span>
                </div>
                <button class="btn-add" id="btn-checkout" style="width:100%; height:54px; font-size:16px;">CONFIRMAR PEDIDO</button>
            </div>
        </aside>
    </div>

    <!-- Auth Modal -->
    <div class="drawer" id="auth-modal">
        <div class="mask"></div>
        <aside class="panel" style="width: 380px; padding: 40px; justify-content: center;">
            <div id="login-form">
                <h2 style="font-weight:900; margin-bottom: 8px;">Bienvenido</h2>
                <p style="color:var(--muted); margin-bottom: 32px;">Ingresá a tu cuenta mayorista</p>
                <input class="auth-btn" style="width:100%; margin-bottom:12px; height: 48px; border: 1px solid var(--line);" type="email" id="login-email" placeholder="Email">
                <input class="auth-btn" style="width:100%; margin-bottom:24px; height: 48px; border: 1px solid var(--line);" type="password" id="login-pass" placeholder="Contraseña">
                <button class="btn-add" style="width:100%; height:48px;" id="btn-do-login">INGRESAR</button>
                <p style="text-align:center; margin-top:20px; font-size:14px;">¿No tenés cuenta? <a href="#" id="go-register" style="color:var(--accent); font-weight:700;">Registrate</a></p>
            </div>

            <div id="register-form" class="hidden">
                <h2 style="font-weight:900; margin-bottom: 8px;">Nuevo Usuario</h2>
                <p style="color:var(--muted); margin-bottom: 24px;">Completá tus datos para el alta</p>
                <input class="auth-btn" style="width:100%; margin-bottom:12px; height: 44px;" id="reg-name" placeholder="Nombre completo">
                <input class="auth-btn" style="width:100%; margin-bottom:12px; height: 44px;" id="reg-dni" placeholder="DNI / CUIT">
                <input class="auth-btn" style="width:100%; margin-bottom:12px; height: 44px;" id="reg-email" placeholder="Email">
                <input class="auth-btn" style="width:100%; margin-bottom:24px; height: 44px;" id="reg-pass" placeholder="Contraseña" type="password">
                <button class="btn-add" style="width:100%; height:48px;" id="btn-do-register">SOLICITAR ALTA</button>
                <p style="text-align:center; margin-top:20px; font-size:14px;">¿Ya tenés cuenta? <a href="#" id="go-login" style="color:var(--accent); font-weight:700;">Logueate</a></p>
            </div>

            <div id="activation-form" class="hidden" style="text-align:center;">
                <div style="background:var(--accent-light); padding:20px; border-radius:20px; margin-bottom:20px;">
                    <i data-lucide="check-circle" style="width:48px; height:48px; color:var(--accent);"></i>
                    <h3 style="margin-top:12px;">¡Casi listo!</h3>
                </div>
                <p style="font-size:14px; margin-bottom:20px;">Pedile tu <b>Código de Acceso</b> a Emanuel por WhatsApp para activar tu cuenta.</p>
                <input class="auth-btn" style="width:100%; height:48px; text-align:center; font-weight:800; border:2px solid var(--accent); margin-bottom:12px;" id="activate-code" placeholder="CÓDIGO AQUÍ">
                <button class="btn-add" style="width:100%; height:48px;" id="btn-do-activate">ACTIVAR MI CUENTA</button>
                <hr style="border:none; border-top:1px solid var(--line); margin:24px 0;">
                <button class="auth-btn" style="width:100%; color:#25D366;" id="btn-wa-emanuel">HABLAR CON EMANUEL</button>
            </div>
        </aside>
    </div>

    <!-- History Drawer -->
    <div class="drawer" id="history-drawer">
        <div class="mask"></div>
        <aside class="panel">
            <div class="panel-head">
                <h2 style="margin:0; font-weight:900;">Mis Pedidos</h2>
                <button class="btn-close" style="background:none; border:none; font-size:32px; cursor:pointer;">&times;</button>
            </div>
            <div class="panel-body" id="history-content">
                <!-- Orders will be injected here -->
            </div>
        </aside>
    </div>

    <script type="module" src="/src/main.js"></script>
</body>
</html>
